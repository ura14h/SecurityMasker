#!/bin/sh
set -eu

SCRIPT_DIRECTORY=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIRECTORY=$(dirname -- "$SCRIPT_DIRECTORY")
PYTHON="$PROJECT_DIRECTORY/.venv/bin/python"

if [ ! -x "$PYTHON" ]; then
    printf '%s\n' "error: run scripts/test-setup first" >&2
    exit 2
fi

cd "$PROJECT_DIRECTORY"

"$PROJECT_DIRECTORY/.venv/bin/ruff" check src tests devtools
"$PROJECT_DIRECTORY/.venv/bin/mypy" src
SM_REQUIRE_MODEL=1 "$PYTHON" -m pytest tests/unit tests/evaluation -q
SM_RUN_LIVE=1 "$PYTHON" -m pytest tests/integration/test_live_gateway.py -q
SM_RUN_OPENAI_E2E=1 SM_OPENAI_E2E_COMPARE_HTTP=1 SM_OPENAI_E2E_TOOL_CALLS=8 \
    "$PYTHON" -m pytest tests/integration/test_real_openai_e2e.py -q
SM_RUN_ANTHROPIC_E2E=1 \
    "$PYTHON" -m pytest tests/integration/test_real_anthropic_e2e.py -q
SM_REQUIRE_ALL_CLIS=1 \
    PYTEST="$PYTHON -m pytest" \
    "$PROJECT_DIRECTORY/devtools/run_cli_e2e.sh"

printf '%s\n' "Local source release checks passed."
